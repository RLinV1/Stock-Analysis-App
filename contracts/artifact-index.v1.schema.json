{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio Lab synthetic artifact index v1",
  "description": "Written by worker/portfolio_worker.py upload_artifacts() under runs/{run_id}/attempts/{attempt_id}/artifact-index.json; served by GET /api/v1/runs/{runId}/manifest after SHA-256 verification.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "attempt_id", "kind", "files"],
  "properties": {
    "run_id": {"type": "string", "format": "uuid"},
    "attempt_id": {"type": "string", "format": "uuid"},
    "kind": {"type": "string", "const": "synthetic-a0"},
    "files": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "properties": {"path": {"const": "report.json"}},
        "required": ["path"]
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "key", "sha256", "bytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "key": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
